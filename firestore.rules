rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Products collection: public read, allow updates/creation for Boricart store
    match /products/{productId} {
      allow read: if isValidId(productId);
      allow write: if isValidId(productId);
    }

    // Categories collection: public read, allow updates/creation
    match /categories/{categoryId} {
      allow read: if isValidId(categoryId);
      allow write: if isValidId(categoryId);
    }

    // Orders collection: Cash on delivery checkout & admin order processing
    match /orders/{orderId} {
      allow read: if isValidId(orderId);
      allow write: if isValidId(orderId);
    }

    // Settings collection: Delivery fees, hero ads configuration, pixels, contact info
    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isValidId(settingId);
    }

    // Admins & Staff management collection
    match /admins/{adminId} {
      allow read: if isValidId(adminId);
      allow write: if isValidId(adminId);
    }

    // Fallback staff collection if referenced
    match /staff/{staffId} {
      allow read: if isValidId(staffId);
      allow write: if isValidId(staffId);
    }
  }
}
