rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Products collection: allow catalog list, get and writes
    match /products/{productId} {
      allow list: if true;
      allow get, write: if isValidId(productId);
    }

    // Categories collection: allow catalog list, get and writes
    match /categories/{categoryId} {
      allow list: if true;
      allow get, write: if isValidId(categoryId);
    }

    // Orders collection: allow admin list, customer get, and writes
    match /orders/{orderId} {
      allow list: if true;
      allow get, write: if isValidId(orderId);
    }

    // Settings collection: allow store settings list, get and writes
    match /settings/{settingId} {
      allow list: if true;
      allow get, write: if isValidId(settingId);
    }

    // Admins & Staff management collection
    match /admins/{adminId} {
      allow list: if true;
      allow get, write: if isValidId(adminId);
    }

    // Fallback staff collection
    match /staff/{staffId} {
      allow list: if true;
      allow get, write: if isValidId(staffId);
    }
  }
}
