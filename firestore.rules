rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'boricartmarketplace@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Products collection
    match /products/{productId} {
      allow get: if isValidId(productId) && (resource.data.status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      // Anyone can create an order with valid Cash on Delivery payload
      allow create: if isValidId(orderId) &&
        request.resource.data.paymentMethod == 'cash_on_delivery' &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() > 1 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() > 5 &&
        request.resource.data.totalAmount is number &&
        request.resource.data.totalAmount > 0;

      // Allow get if admin or if accessed right after creation
      allow get: if isValidId(orderId);
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
